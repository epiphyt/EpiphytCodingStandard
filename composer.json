{
    "name": "epiphyt/coding-standard",
    "description": "Epiphyt Coding Standard for PHP_CodeSniffer extends the WordPress Coding Standard by providing sniffs with additional checks.",
    "type": "phpcodesniffer-standard",
    "license": "MIT",
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require": {
        "squizlabs/php_codesniffer": "^3.13.5",
        "wp-coding-standards/wpcs": "^3.4.1",
        "phpcompatibility/php-compatibility": "^9.3.5",
        "phpcompatibility/phpcompatibility-paragonie": "^1.3.4",
        "phpcompatibility/phpcompatibility-wp": "^2.1.8",
        "slevomat/coding-standard": "^8.22.1"
    }
}
